{
  "rewrites": [
    {
      "source": "/product.html",
      "has": [{ "type": "query", "key": "id" }],
      "destination": "/api/product"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "store" }],
      "destination": "/api/home"
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "store" }],
      "destination": "/api/home"
    }
  ]
}